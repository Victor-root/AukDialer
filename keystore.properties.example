# Copy this file to keystore.properties and fill in your own values.
#
# keystore.properties is never committed, it holds passwords. Without it the
# debug build falls back to Android's throwaway debug key and the release build
# comes out unsigned.
#
# Use forward slashes in the path, on Windows too.

storeFile=D:/Nextcloud/Victor/Documents/AndroidStudio-KEYS/victor-release-key
storePassword=
keyAlias=
keyPassword=
