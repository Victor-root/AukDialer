    <style name="Theme.App.Starting.LightGreen" parent="Theme.App.Starting">
        <item name="windowSplashScreenBackground">#8BC34A</item>
    </style>
    <style name="Theme.App.Starting.Lime" parent="Theme.App.Starting">
        <item name="windowSplashScreenBackground">#CDDC39</item>
    </style>
    <style name="Theme.App.Starting.Yellow" parent="Theme.App.Starting">
        <item name="windowSplashScreenBackground">#E6C400</item>
    </style>
    <style name="Theme.App.Starting.Amber" parent="Theme.App.Starting">
        <item name="windowSplashScreenBackground">#FFC107</item>
