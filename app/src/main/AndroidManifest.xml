            android:excludeFromRecents="true"
            android:showForAllUsers="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:directBootAware="true"
            android:theme="@style/Theme.AukDialer" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".controller.CallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:foregroundServiceType="phoneCall|microphone"
            android:directBootAware="true"
            android:exported="true">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <!--
            Telecom hides self-managed calls (VoIP-style, incl. the debug test line above) from an
            InCallService by default, even the default dialer, unless it opts in here. CallService
            filters out any self-managed call that isn't its own debug test line, so this doesn't
            pull other apps' VoIP calls (WhatsApp, Signal, ...) onto AukDialer's call screen.
            -->
            <meta-data
                android:name="android.telecom.INCLUDE_SELF_MANAGED_CALLS"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!--
        Backs the debug-only "Simulate an incoming call" Settings button (DebugCallSimulator):
        a self-managed line Telecom never routes to unless that account gets registered, which only
        happens in debug builds, so this stays dormant in release.
        -->
        <service
            android:name=".controller.DebugCallConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

